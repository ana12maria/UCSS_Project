@{
    ViewData["Title"] = "Adaugă Orar";
}

<style>
    body {
        background-color: #f8f9fc; /* Un fundal gri foarte deschis și modern */
    }
    .form-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1); /* Umbră fină pentru efect 3D */
        background: white;
        padding: 40px;
        transition: transform 0.3s ease;
    }
    .form-card:hover {
        transform: translateY(-5px); /* Se ridică puțin când pui mouse-ul pe ea */
    }
    .header-title {
        font-weight: 800;
        color: #4e73df; /* Albastru profesional */
    }
    .btn-custom {
        background-color: #4e73df;
        color: white;
        border-radius: 10px;
        font-weight: bold;
        font-size: 1.1rem;
        transition: all 0.3s;
    }
    .btn-custom:hover {
        background-color: #2e59d9;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(78, 115, 223, 0.4); /* Butonul luminează la hover */
    }
    .form-control, .form-select {
        border-radius: 8px;
        border: 1px solid #d1d3e2;
        padding: 10px 15px;
    }
    .form-control:focus {
        border-color: #4e73df;
        box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
    }
</style>

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="header-title">🎓 Sistem Planificare Orar</h1>
        <p class="text-muted" style="font-size: 1.2rem;">Creează și gestionează orarul cursurilor rapid și eficient.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-card">
                <h4 class="mb-4 border-bottom pb-3 text-secondary">📅 Adaugă un curs nou</h4>
                
                <form method="post" action="/Home/AdaugaOrar">
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-dark fw-bold">👩‍🏫 ID Profesor</label>
                            <input type="number" class="form-control" name="teacherId" required placeholder="Ex: 1" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-dark fw-bold">🚪 ID Sală</label>
                            <input type="number" class="form-control" name="roomId" required placeholder="Ex: 10" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-dark fw-bold">📚 Materia</label>
                            <input type="text" class="form-control" name="subject" required placeholder="Ex: Programare" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-dark fw-bold">👥 Grupa</label>
                            <input type="text" class="form-control" name="groupName" required placeholder="Ex: Grupa 101" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-dark fw-bold">📆 Ziua Săptămânii</label>
                        <select class="form-select form-control" name="day">
                            <option value="Luni">Luni</option>
                            <option value="Marti">Marți</option>
                            <option value="Miercuri">Miercuri</option>
                            <option value="Joi">Joi</option>
                            <option value="Vineri">Vineri</option>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label text-dark fw-bold">⏰ Ora de Început</label>
                            <input type="number" class="form-control" name="startTime" required placeholder="Ex: 8" min="8" max="20" />
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label text-dark fw-bold">⌛ Ora de Sfârșit</label>
                            <input type="number" class="form-control" name="endTime" required placeholder="Ex: 10" min="9" max="22" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-custom w-100 py-3 mt-2">✨ Salvează Orarul</button>
                </form>
            </div>
        </div>
    </div>
</div>